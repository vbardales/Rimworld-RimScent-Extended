<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Chaque parfum est accroche a son HediffDef, pas a l'objet : c'est le colon
       parfume que l'on sent, pas le flacon dans la reserve.

       Structure de chaque bloc : on ajoute a la liste modExtensions si elle existe,
       sinon on la cree - et si le def lui-meme est absent, le conditionnel imbrique
       fait qu'il ne se passe rien, sans erreur de chargement. C'est ce qui permet de
       traiter le parfum d'anima, dont le def porte un MayRequire, sans garde
       supplementaire. -->

  <!-- Parfum floral -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/HediffDef[defName="Romy_FlowerPerfume"]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/HediffDef[defName="Romy_FlowerPerfume"]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_PerfumeFlower</thought>
        </li>
      </value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/HediffDef[defName="Romy_FlowerPerfume"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>Defs/HediffDef[defName="Romy_FlowerPerfume"]</xpath>
        <value>
          <modExtensions>
            <li Class="RimScentReworked.ModExtension_Scent">
              <thought>RimScentExtended_Scent_PerfumeFlower</thought>
            </li>
          </modExtensions>
        </value>
      </match>
    </nomatch>
  </Operation>

