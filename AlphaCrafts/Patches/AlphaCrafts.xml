  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="AC_Vinegar" or defName="AC_Pickles" or defName="AC_PickledEggs") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="AC_Vinegar" or defName="AC_Pickles" or defName="AC_PickledEggs") and not(modExtensions)]</xpath>
