          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Vinaigre, cornichons et oeufs au vinaigre : meme famille acetique. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="AC_Vinegar" or defName="AC_Pickles" or defName="AC_PickledEggs") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="AC_Vinegar" or defName="AC_Pickles" or defName="AC_PickledEggs") and modExtensions]/modExtensions</xpath>
