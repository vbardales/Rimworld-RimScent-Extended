  <!-- Le fermenteur artisanal reutilise l'odeur de fermentation du volet Core, celle du fut vanilla. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="AC_VinegarCask") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="AC_VinegarCask") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Fermenting</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="AC_VinegarCask") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="AC_VinegarCask") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Fermenting</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

</Patch>
