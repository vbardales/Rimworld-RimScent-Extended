  </Operation>

  <!-- Essences, et l'infuseur qui les produit. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="AC_Essence" or defName="AC_Infuser") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="AC_Essence" or defName="AC_Infuser") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Essence</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="AC_Essence" or defName="AC_Infuser") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="AC_Essence" or defName="AC_Infuser") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
