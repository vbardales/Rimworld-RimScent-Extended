<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Regle generique, sur le critere du jeu lui-meme : building/isMealSource="true".

       C'est le meme procede que le patch fleurs. Plutot que d'enumerer les fourneaux mod
       par mod - ce que faisait la premiere version de ce fichier - on suit le marqueur que
       RimWorld utilise deja pour designer un poste qui produit des repas. Resultat sur
       cette liste de mods : 16 postes couverts sur 10 mods, dont sept que l'enumeration a
       la main avait manques (VFE Production, VCE Stews, VCE Sushi, VCE Haute,
       Thermodynamics Hot Meals, Fireplace...), et tout mod de cuisine installe plus tard.

       Le marqueur est aussi plus juste que mon jugement l'etait : j'avais ecarte la machine
       a conserves, la presse a fromage et la table a condiments de Vanilla Cooking Expanded
       en estimant qu'elles ne cuisent rien. Le jeu les marque isMealSource. On suit le jeu.

       Le gate reste gratuit : ces postes portent tous un CompPowerTrader ou un
       CompRefuelable, deja testes par RimScent.

       Trois exceptions, nommees parce que ce sont des exceptions :
         - les deux fours de boulangerie gardent leur odeur de pain, plus specifique ;
         - le distributeur de pate nutritive a la sienne, et elle n'est pas appetissante ;
         - le feu de camp est deja pris par RimScent_CampfireScent - le predicat
           l'ecarte tout seul, puisqu'il porte deja une ModExtension_Scent. -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[building/isMealSource="true" and not(defName="VCE_BakeryOven_Electric" or defName="VCE_BakeryOven_Fueled" or defName="NutrientPasteDispenser") and modExtensions and not(modExtensions/li[@Class="RimScentReworked.ModExtension_Scent"])]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[building/isMealSource="true" and not(defName="VCE_BakeryOven_Electric" or defName="VCE_BakeryOven_Fueled" or defName="NutrientPasteDispenser") and modExtensions and not(modExtensions/li[@Class="RimScentReworked.ModExtension_Scent"])]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Cooking</thought>
        </li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[building/isMealSource="true" and not(defName="VCE_BakeryOven_Electric" or defName="VCE_BakeryOven_Fueled" or defName="NutrientPasteDispenser") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[building/isMealSource="true" and not(defName="VCE_BakeryOven_Electric" or defName="VCE_BakeryOven_Fueled" or defName="NutrientPasteDispenser") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Cooking</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Le distributeur de pate nutritive. Marque isMealSource, mais ce qu'il produit n'a
       pas grand-chose a voir avec de la cuisine, et le jeu lui-meme punit deja le fait
       d'en manger. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="NutrientPasteDispenser" and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="NutrientPasteDispenser" and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_NutrientPaste</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="NutrientPasteDispenser" and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="NutrientPasteDispenser" and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_NutrientPaste</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

</Patch>
