<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- RimScent donne RimScent_FloweryScent a trois plantes, nommement : Plant_Rose,
       Plant_Daylily et Plant_Dandelion. Or ces trois-la sont exactement, et seules, les
       plantes vanilla qui portent plant/purpose = "Beauty". Le critere implicite de
       l'amont est donc celui-ci : on le rend explicite, et toutes les plantes
       decoratives des mods en heritent sans avoir a les enumerer.

       Sur cette liste de mods, ca couvre entre autres Spidercamp's Decorative Plants,
       Vanilla Plants Expanded (Succulents et More Plants), Glowmoss, Houseplants
       Remastered et Flowers (Continued) - et tout mod de fleurs installe plus tard.

       Aucune nouvelle ThoughtDef : on reutilise celle de l'amont, deja traduite.

       Deux operations disjointes, parce qu'un PatchOperationAdd ne sait pas creer le
       noeud modExtensions sur certains defs et l'alimenter sur d'autres en une passe.
       Chacune est enveloppee dans un PatchOperationConditional pour ne rien signaler
       quand elle ne correspond a rien - sans quoi une partie sans mod de fleurs
       produirait une erreur de chargement.

       Le predicat exclut les defs qui portent deja une ModExtension_Scent : cela ecarte
       d'office les trois plantes vanilla et celles d'Overflowing Flowers, que RimScent
       a patchees avant nous (nos patchs passent apres, loadAfter oblige). Les defs
       abstraits sont ecartes aussi, pour ne pas ajouter l'extension au parent puis a
       l'enfant qui en herite. -->

  <!-- 1. La plante a deja des modExtensions : on s'ajoute a la liste. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[not(@Abstract="True") and plant/purpose="Beauty" and modExtensions and not(modExtensions/li[@Class="RimScentReworked.ModExtension_Scent"])]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[not(@Abstract="True") and plant/purpose="Beauty" and modExtensions and not(modExtensions/li[@Class="RimScentReworked.ModExtension_Scent"])]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScent_FloweryScent</thought>
        </li>
      </value>
    </match>
  </Operation>

  <!-- 2. La plante n'en a aucune : on cree le noeud. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[not(@Abstract="True") and plant/purpose="Beauty" and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[not(@Abstract="True") and plant/purpose="Beauty" and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScent_FloweryScent</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

</Patch>
