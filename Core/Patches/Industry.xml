<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Une operation par odeur, motif a predicats disjoints pour la fermentation qui vise
       deux defs. Le crematorium et la fonderie sont seuls, mais on garde le meme motif
       par homogeneite - et parce qu'un mod peut leur avoir ajoute des modExtensions. -->

  <!-- Crematorium : CompPowerTrader + CompFlickable, donc gate deux fois. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="ElectricCrematorium" and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="ElectricCrematorium" and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Crematorium</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="ElectricCrematorium" and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="ElectricCrematorium" and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Crematorium</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Fonderie : idem. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="ElectricSmelter" and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="ElectricSmelter" and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Smelter</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="ElectricSmelter" and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="ElectricSmelter" and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Smelter</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Fermentation : le fut et la brasserie. Aucun des deux n'a d'alimentation, donc
       l'odeur est permanente. La brasserie ancienne d'Odyssey est ecartee : c'est une
       ruine decorative, plus rien n'y brasse depuis longtemps. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="FermentingBarrel" or defName="Brewery") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="FermentingBarrel" or defName="Brewery") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Fermenting</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="FermentingBarrel" or defName="Brewery") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="FermentingBarrel" or defName="Brewery") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Fermenting</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

</Patch>
