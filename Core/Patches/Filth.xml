    <xpath>Defs/ThingDef[(defName="Filth_DriedBlood" or defName="Filth_DarkBlood" or defName="Filth_DarkBloodSmear" or defName="Filth_RevenantBloodPool" or defName="Filth_RevenantSmear") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Filth_DriedBlood" or defName="Filth_DarkBlood" or defName="Filth_DarkBloodSmear" or defName="Filth_RevenantBloodPool" or defName="Filth_RevenantSmear") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScent_BloodScent</thought>
          <dysosmicTraits>
            <li>Bloodlust</li>
            <li>Psychopath</li>
          </dysosmicTraits>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Filth_DriedBlood" or defName="Filth_DarkBlood" or defName="Filth_DarkBloodSmear" or defName="Filth_RevenantBloodPool" or defName="Filth_RevenantSmear") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Filth_DriedBlood" or defName="Filth_DarkBlood" or defName="Filth_DarkBloodSmear" or defName="Filth_RevenantBloodPool" or defName="Filth_RevenantSmear") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScent_BloodScent</thought>
          <dysosmicTraits>
            <li>Bloodlust</li>
            <li>Psychopath</li>
          </dysosmicTraits>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

