<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Les saletes vanilla et DLC que RimScent laisse inodores. Presque tout se regle en
       reutilisant ses propres pensees, deja traduites.

       Deux d'entre elles sont ORPHELINES en amont : RimScent_FirefoamScent (« flat
       chemical foam ») et RimScent_ExplosionScent (« sulfur and ozone ») sont definies mais
       jamais accrochees a quoi que ce soit. Or Filth_FireFoam et Filth_BlastMark existent
       et correspondent exactement a leur description. On les branche enfin.

       Beaucoup de ces defs viennent d'Anomaly ou de Biotech : sans le DLC elles n'existent
       pas, et le motif a predicats disjoints les ignore sans erreur. -->

  <!-- Mousse anti-incendie. Pensee ORPHELINE en amont, dont la description parle justement de mousse extinctrice. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Filth_FireFoam") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Filth_FireFoam") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScent_FirefoamScent</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Filth_FireFoam") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Filth_FireFoam") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScent_FirefoamScent</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Marque d'explosion. Seconde pensee ORPHELINE en amont : soufre et ozone. -->
