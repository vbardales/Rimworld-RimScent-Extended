<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Objets vanilla odorants que RimScent laissait muets. Une seule odeur nouvelle -
       les herbes sechees - le reste reutilise des pensees deja ecrites et traduites.

       La viande crue et le cuir sont volontairement absents : leurs defs sont generees
       par race (Meat_Cow, Leather_Bear...) et donc IMPLICITES, hors de portee d un xpath,
       comme les cadavres. La viande avariee, elle, est bien couverte - par le mecanisme
       de putrefaction dans ScentScan, qui ne passe pas par les defs. -->

  <!-- Biere et mout : c est de la fermentation, comme le fut et la brasserie. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Beer" or defName="Wort") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Beer" or defName="Wort") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Fermenting</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Beer" or defName="Wort") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Beer" or defName="Wort") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Fermenting</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Le chimiburant en reserve. RimScent couvrait la flaque et les generateurs, pas le bidon. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Chemfuel") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Chemfuel") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScent_FuelScent</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Chemfuel") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Chemfuel") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScent_FuelScent</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Les drogues de synthese et le neutroamine : odeur de produit chimique, la meme que les laboratoires medicaux. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Yayo" or defName="Flake" or defName="GoJuice" or defName="Luciferium" or defName="Penoxycyline" or defName="Neutroamine") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Yayo" or defName="Flake" or defName="GoJuice" or defName="Luciferium" or defName="Penoxycyline" or defName="Neutroamine") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Pharmacy</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Yayo" or defName="Flake" or defName="GoJuice" or defName="Luciferium" or defName="Penoxycyline" or defName="Neutroamine") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Yayo" or defName="Flake" or defName="GoJuice" or defName="Luciferium" or defName="Penoxycyline" or defName="Neutroamine") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Pharmacy</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Foin, houblon et herbes medicinales : du vegetal coupe et seche. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Hay" or defName="RawHops" or defName="MedicineHerbal") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Hay" or defName="RawHops" or defName="MedicineHerbal") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_DriedHerbs</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Hay" or defName="RawHops" or defName="MedicineHerbal") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Hay" or defName="RawHops" or defName="MedicineHerbal") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_DriedHerbs</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

</Patch>
