<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- RimScent couvre 12 des 42 saletes du jeu de base et des DLC. Le patch qui accompagne
       ce fichier en rattrape 18 de plus, dont l'ecrasante majorite en REUTILISANT les
       pensees de l'amont : elles existent, elles sont traduites, et la salete manquante est
       souvent la jumelle d'une salete deja couverte - sang seche contre sang frais, cendre
       volcanique contre cendre, gravats contre terre.

       Deux cas meritent une odeur a eux, faute d'equivalent en amont. -->

  <ThoughtDef Name="RimScentExtended_FilthScentBase" Abstract="True">
    <durationDays>0.1</durationDays>
    <stackLimit>3</stackLimit>
  </ThoughtDef>

  <ThoughtDef ParentName="RimScentExtended_FilthScentBase">
    <defName>RimScentExtended_Scent_Mould</defName>
    <stages>
      <li>
        <label>mould</label>
        <description>Damp cloth left too long in the dark. Musty, and it catches in the throat.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="RimScentExtended_FilthScentBase">
    <defName>RimScentExtended_Scent_Slime</defName>
    <stages>
      <li>
        <label>slime</label>
        <description>A cold, organic film underfoot. It smells faintly of pond water and something else.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Nourriture avariee. Aucun def n a besoin d etre patche : ScentScan lit
       RottableUtility.GetRotStage() sur tout objet porteur d un CompRottable, donc
       cela couvre les aliments de tous les mods installes, presents et futurs.
       Le meme mecanisme que les cadavres, applique a ce qui se mange. -->
  <ThoughtDef>
    <defName>RimScentExtended_Scent_RottenFood</defName>
    <durationDays>0.1</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>spoiled food</label>
        <description>Something in the stores has turned. Sweet, sour and unmistakably off.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
