<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- 1. Les quatre postes de cuisson, avec l'odeur de cuisine du volet Core. Verifie :
          tous portent un CompPowerTrader ou un CompRefuelable, donc deja gates par
          RimScent - eteints ou sans combustible, ils ne sentent pas.

          Le banc de preparation (SC_PrepTable) est laisse de cote : on y prepare, on n'y
          cuit pas, et il n'a aucune alimentation qui dirait s'il sert. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="SC_DwarvenOven" or defName="SC_PortablePot" or defName="SC_ArchotechMicrowave") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="SC_DwarvenOven" or defName="SC_PortablePot" or defName="SC_ArchotechMicrowave") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Cooking</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="SC_DwarvenOven" or defName="SC_PortablePot" or defName="SC_ArchotechMicrowave") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="SC_DwarvenOven" or defName="SC_PortablePot" or defName="SC_ArchotechMicrowave") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Cooking</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- 2. Le sechoir. Il traite SC_CureMeat, SC_CureInsectMeat, SC_CureHumanMeat et
          SC_CureFish - sel, fumee, viande qui seche. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="SC_CuringRack"]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="SC_CuringRack"]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Curing</thought>
        </li>
      </value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/ThingDef[defName="SC_CuringRack"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="SC_CuringRack"]</xpath>
        <value>
          <modExtensions>
            <li Class="RimScentReworked.ModExtension_Scent">
              <thought>RimScentExtended_Scent_Curing</thought>
            </li>
          </modExtensions>
        </value>
      </match>
    </nomatch>
  </Operation>

</Patch>
