<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Les quatre postes de cuisson du mod - gril, four nain, marmite portative et
       micro-generateur quantique - reutilisent l'odeur de cuisine du volet Core : tous
       les quatre portent un CompPowerTrader ou un CompRefuelable, donc ils ne sentent
       qu'en service, sans test supplementaire.

       Restent deux odeurs qui leur sont propres, et qui n'ont pas d'equivalent en amont.
       Ni le sechoir ni l'insectarium n'ont de comp d'alimentation : ils sentiront en
       permanence. C'est correct pour ce qu'ils sont - un sechoir sent le sel et la fumee
       meme a vide, une ruche d'insectes n'a pas d'interrupteur. -->

  <ThoughtDef>
    <defName>RimScentExtended_Scent_Curing</defName>
    <durationDays>0.1</durationDays>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <label>curing meat</label>
        <description>Salt, smoke and drying meat. It smells of a larder being stocked for winter.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
