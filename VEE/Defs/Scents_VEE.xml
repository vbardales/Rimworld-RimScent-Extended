<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Vanilla Events Expanded ajoute 5 meteos et 10 conditions, dont aucune ne sentait
       quoi que ce soit. Les conditions et la meteo sont lues a l'echelle de la carte par
       RimScent - hors boucle de cellules - donc chaque odeur ici touche toute la colonie
       d'un coup. D'ou la retenue sur les valeurs.

       Toutes les odeurs de ce fichier sont a stackLimit 1 : une condition et une meteo
       peuvent porter la meme odeur simultanement, et il ne faut pas la compter deux fois.

       On ne parfume que ce qui sent vraiment. Whiteout, long night, psychic stimulation,
       psychic overdrive et psychic hum n'ont volontairement aucune odeur : le froid et
       les phenomenes psychiques n'en ont pas, et leur en inventer une serait du bruit. -->

  <ThoughtDef Name="RimScentExtended_EventScentBase" Abstract="True">
    <durationDays>0.1</durationDays>
    <stackLimit>1</stackLimit>
  </ThoughtDef>

  <ThoughtDef ParentName="RimScentExtended_EventScentBase">
    <defName>RimScentExtended_Scent_Drought</defName>
    <stages>
      <li>
        <label>parched air</label>
        <description>Dust, cracked earth and dead grass. There is not a trace of moisture in the air.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="RimScentExtended_EventScentBase">
    <defName>RimScentExtended_Scent_Swelter</defName>
    <stages>
      <li>
        <label>sweltering air</label>
        <description>Hot, still, heavy air that smells of sweat and baked dust. Every breath feels used.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="RimScentExtended_EventScentBase">
    <defName>RimScentExtended_Scent_PsychicBloom</defName>
    <stages>
      <li>
        <label>alien blossom</label>
        <description>A sweet, heavy floral scent drifts everywhere. It is pleasant, and nothing on this world smells like it.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
