<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Motif a predicats disjoints partout : les groupes melangent des defs qui ont deja
       des modExtensions et d'autres non, et un match/nomatch classique n'en couvrirait
       qu'une moitie. -->

  <!-- 1. Les trois Scenters, portes. HediffDef, donc sentis sur le pion voisin. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/HediffDef[(defName="HedSSScentNeutral" or defName="HedSSScentMale" or defName="HedSSScentFemale") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/HediffDef[(defName="HedSSScentNeutral" or defName="HedSSScentMale" or defName="HedSSScentFemale") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_WornScent</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/HediffDef[(defName="HedSSScentNeutral" or defName="HedSSScentMale" or defName="HedSSScentFemale") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/HediffDef[(defName="HedSSScentNeutral" or defName="HedSSScentMale" or defName="HedSSScentFemale") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_WornScent</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- 2. Le vapotage, sur le hediff : l'odeur dure ce que dure l'effet. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/HediffDef[(defName="SSVape_Regular_High" or defName="SSVape_Fruity_High") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/HediffDef[(defName="SSVape_Regular_High" or defName="SSVape_Fruity_High") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Vapour</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/HediffDef[(defName="SSVape_Regular_High" or defName="SSVape_Fruity_High") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/HediffDef[(defName="SSVape_Regular_High" or defName="SSVape_Fruity_High") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Vapour</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- 3. La menthe : haleine (bain de bouche, the a la menthe) et plante sur pied. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/HediffDef[(defName="SSMouthWash_High" or defName="SSMintTea_High") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/HediffDef[(defName="SSMouthWash_High" or defName="SSMintTea_High") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Mint</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/HediffDef[(defName="SSMouthWash_High" or defName="SSMintTea_High") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/HediffDef[(defName="SSMouthWash_High" or defName="SSMintTea_High") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Mint</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Plant_SSMint" or defName="SSMintLeaves") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Plant_SSMint" or defName="SSMintLeaves") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Mint</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Plant_SSMint" or defName="SSMintLeaves") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Plant_SSMint" or defName="SSMintLeaves") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Mint</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- 4. Le piment. Un tas de piments ou de sauce piquante pique les yeux. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="SSChilliPeppers" or defName="SSHotSauce") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="SSChilliPeppers" or defName="SSHotSauce") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Chilli</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="SSChilliPeppers" or defName="SSHotSauce") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="SSChilliPeppers" or defName="SSHotSauce") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Chilli</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- 5. La polyfleur et ses derives. Elle ne porte pas purpose="Beauty", donc le patch
          fleurs ne l'attrapait pas - d'ou ce traitement nominatif, avec l'odeur florale
          de l'amont plutot qu'une nouvelle. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Plant_SSPolyflower" or defName="SSPolyPetals" or defName="SSPolyflowerJuice") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Plant_SSPolyflower" or defName="SSPolyPetals" or defName="SSPolyflowerJuice") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScent_FloweryScent</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="Plant_SSPolyflower" or defName="SSPolyPetals" or defName="SSPolyflowerJuice") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="Plant_SSPolyflower" or defName="SSPolyPetals" or defName="SSPolyflowerJuice") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScent_FloweryScent</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

</Patch>
