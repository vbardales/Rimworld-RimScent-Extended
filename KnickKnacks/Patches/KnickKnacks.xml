<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Les bibelots de Knick Knacks. Le mod pose un JobDef de decoration et des JoyGiver qui en sement automatiquement : d'ou stackLimit 1 sur les pensees, definies dans le volet Core. Boite, ronds de serviette et cadres photo n'ont volontairement aucune odeur. -->

  <!-- Le flacon vaporisateur : un desodorisant d'ambiance, dont l'identite entiere est l'odeur. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="SEX_Scents") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="SEX_Scents") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_AirFreshener</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="SEX_Scents") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="SEX_Scents") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_AirFreshener</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Le vase, qui contient du feuillage et non des fleurs - verifie sur la texture. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="SEX_Vase") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="SEX_Vase") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Houseplant</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="SEX_Vase") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="SEX_Vase") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Houseplant</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Les feuilles volantes. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="SEX_Paper") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="SEX_Paper") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_OldPaper</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="SEX_Paper") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="SEX_Paper") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_OldPaper</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

</Patch>
