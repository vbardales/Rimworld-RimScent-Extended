<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Colonists' Deco. Affiches, attrape-reves, formes en laiton, boules de papier et bibelots archotech restent inodores : rien n'y sent. -->

  <!-- Le livre de chevet. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="DECOBedsideBook") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="DECOBedsideBook") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_OldPaper</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="DECOBedsideBook") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="DECOBedsideBook") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_OldPaper</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Les deux trophees de chasse empailles. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="DECOBoarhead" or defName="DECODeerhead") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="DECOBoarhead" or defName="DECODeerhead") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Taxidermy</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="DECOBoarhead" or defName="DECODeerhead") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(defName="DECOBoarhead" or defName="DECODeerhead") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
          <li Class="RimScentReworked.ModExtension_Scent">
            <thought>RimScentExtended_Scent_Taxidermy</thought>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

</Patch>
