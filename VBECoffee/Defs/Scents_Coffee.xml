<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Deux odeurs pour Vanilla Brewing Expanded - Coffees and Teas : le cafe et le the.
       Elles couvrent la machine a espresso, qui ne sent qu'alimentee, et les boissons
       elles-memes, tasse posee sur une table ou pile en reserve.

       stackLimit 1 : une reserve de trente cafes ne sent pas trente fois. -->

  <ThoughtDef>
    <defName>RimScentExtended_Scent_Coffee</defName>
    <durationDays>0.1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>coffee aroma</label>
        <description>Fresh coffee. Roasted, dark and bitter, and somehow it makes the day look manageable.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RimScentExtended_Scent_Tea</defName>
    <durationDays>0.1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>brewed tea</label>
        <description>Steeping tea leaves. Warm, grassy and calm.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
